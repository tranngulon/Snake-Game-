<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Désiré Edition</title>
    <!-- Font Awesome 6 (free) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: #0a0a12;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .card {
            max-width: 600px;
            width: 100%;
            background: #14141f;
            border-radius: 40px;
            padding: 30px 25px;
            box-shadow: 0 25px 50px -8px rgba(0,0,0,0.6);
            border: 1px solid #2a2a3a;
        }

        /* Header với avatar bên trái */
        .header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .avatar-small {
            width: 70px;
            height: 70px;
            background: linear-gradient(145deg, #7c3aed, #a855f7);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 700;
            color: white;
            box-shadow: 0 10px 20px rgba(124, 58, 237, 0.3);
            border: 2px solid rgba(255,255,255,0.1);
            flex-shrink: 0;
        }

        .header-text {
            flex: 1;
        }

        .header-text h1 {
            color: white;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .header-text .sub {
            color: #9b9bb0;
            font-size: 14px;
            background: rgba(255,255,255,0.03);
            display: inline-block;
            padding: 4px 12px;
            border-radius: 100px;
            border: 1px solid #2a2a3a;
        }

        .section-title {
            color: #5f5f7a;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 1px;
            font-weight: 600;
            margin: 25px 0 12px 5px;
        }

        .link-item {
            display: flex;
            align-items: center;
            background: #1e1e2c;
            border-radius: 20px;
            padding: 14px 18px;
            margin-bottom: 10px;
            text-decoration: none;
            transition: 0.2s;
            border: 1px solid #2d2d3f;
        }

        .link-item:hover {
            background: #252536;
            border-color: #3f3f5a;
            transform: translateY(-2px);
        }

        /* Icon thật của app (Font Awesome) */
        .icon-box {
            width: 44px;
            height: 44px;
            background: #0f0f1a;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 18px;
            font-size: 24px;
            color: white;
            border: 1px solid #3a3a52;
        }

        .link-content {
            flex: 1;
        }

        .link-title {
            color: white;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .link-desc {
            color: #7a7a9a;
            font-size: 13px;
        }

        .badge {
            background: #2f2f44;
            color: #bdbde9;
            padding: 4px 10px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
            margin-left: 10px;
            border: 1px solid #41415a;
        }

        .footer {
            text-align: center;
            margin-top: 35px;
            color: #4a4a66;
            font-size: 13px;
            border-top: 1px solid #242434;
            padding-top: 25px;
        }
    </style>
</head>
<body>
    <div class="card">
        <!-- Header: avatar nhỏ bên trái -->
        <div class="header">
            <div class="avatar-small">D</div>
            <div class="header-text">
                <h1>Désiré Edition</h1>
                <span class="sub">⚡ Creator • GhtVN • Xbox Theme</span>
            </div>
        </div>

        <!-- NỀN TẢNG CHÍNH -->
        <div class="section-title">NỀN TẢNG CHÍNH</div>
        <div class="links">
            <!-- YouTube -->
            <a href="https://youtube.com/@ghtvnnew?si=27asw5PMfzislrtr" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-youtube"></i></div>
                <div class="link-content">
                    <div class="link-title">YouTube</div>
                    <div class="link-desc">@ghtvnnew • 1 năm trước</div>
                </div>
                <span class="badge">GhtVN</span>
            </a>

            <!-- TikTok 1 -->
            <a href="https://vm.tiktok.com/ZS9dPnNWAGwh9-P8FMU/" target="_blank" class="link-item" onclick="return confirm('Link này có thể đã ngừng hoạt động ở Hong Kong. Vẫn mở?')">
                <div class="icon-box"><i class="fab fa-tiktok"></i></div>
                <div class="link-content">
                    <div class="link-title">TikTok</div>
                    <div class="link-desc">@ght.8.vn • Video 1</div>
                </div>
            </a>

            <!-- WhatsApp -->
            <a href="https://chat.whatsapp.com/DZ4DaWE1kX7LElqVMHQokk" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-whatsapp"></i></div>
                <div class="link-content">
                    <div class="link-title">WhatsApp</div>
                    <div class="link-desc">Désiré Theme TG • Nhóm chat</div>
                </div>
            </a>
        </div>

        <!-- MẠNG XÃ HỘI KHÁC -->
        <div class="section-title">MẠNG XÃ HỘI KHÁC</div>
        <div class="links">
            <!-- Telegram -->
            <a href="https://t.me/boost/ghtvnzVN" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-telegram-plane"></i></div>
                <div class="link-content">
                    <div class="link-title">Telegram</div>
                    <div class="link-desc">Désiré Xbox Theme • 4 subs</div>
                </div>
                <span class="badge">KLCK/KLWP</span>
            </a>

            <!-- Facebook -->
            <a href="https://www.facebook.com/GhtVNDesire" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-facebook"></i></div>
                <div class="link-content">
                    <div class="link-title">Facebook</div>
                    <div class="link-desc">Ght Nguyễn • 10 followers</div>
                </div>
            </a>

            <!-- Instagram -->
            <a href="https://www.instagram.com/ght.8.vn?igsh=MW4zOWJ1czA1cDQ3aw==" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-instagram"></i></div>
                <div class="link-content">
                    <div class="link-title">Instagram</div>
                    <div class="link-desc">@ght.8.vn</div>
                </div>
            </a>

            <!-- Threads -->
            <a href="https://www.threads.com/@ght.8.vn" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-threads"></i></div>
                <div class="link-content">
                    <div class="link-title">Threads</div>
                    <div class="link-desc">@ght.8.vn</div>
                </div>
            </a>

            <!-- Reddit -->
            <a href="https://www.reddit.com/u/BrilliantAd37/s/MAeKhzrXPc" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-reddit-alien"></i></div>
                <div class="link-content">
                    <div class="link-title">Reddit</div>
                    <div class="link-desc">u/BrilliantAd37 • 2025</div>
                </div>
            </a>

            <!-- TapTap -->
            <a href="https://www.taptap.io/user/690703273?share_id=2cfc83049a4b&utm_medium=share&utm_source=copylink" target="_blank" class="link-item">
                <div class="icon-box"><i class="fas fa-gamepad"></i></div>
                <div class="link-content">
                    <div class="link-title">TapTap</div>
                    <div class="link-desc">Desire HD • 9 muốn chơi</div>
                </div>
            </a>

            <!-- Discord (cảnh báo) -->
            <a href="https://discord.gg/NDISCOVER" target="_blank" class="link-item" onclick="return confirm('Link Discord có thể đã hết hạn. Vẫn mở?')">
                <div class="icon-box"><i class="fab fa-discord"></i></div>
                <div class="link-content">
                    <div class="link-title">Discord</div>
                    <div class="link-desc">NDISCOVER</div>
                </div>
            </a>

            <!-- Bluesky -->
            <a href="https://bsky.app/profile/ghtvndesire.bsky.social" target="_blank" class="link-item">
                <div class="icon-box"><i class="fas fa-cloud"></i></div>
                <div class="link-content">
                    <div class="link-title">Bluesky</div>
                    <div class="link-desc">@ghtvndesire.bsky.social</div>
                </div>
            </a>

            <!-- TikTok 2 -->
            <a href="https://vm.tiktok.com/ZS9dPcqTPK5s7-ltfhv/" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-tiktok"></i></div>
                <div class="link-content">
                    <div class="link-title">TikTok 2</div>
                    <div class="link-desc">Video khác</div>
                </div>
            </a>

            <!-- TikTok 3 -->
            <a href="https://vm.tiktok.com/ZS9dPcGtELnXY-LHVDS/" target="_blank" class="link-item">
                <div class="icon-box"><i class="fab fa-tiktok"></i></div>
                <div class="link-content">
                    <div class="link-title">TikTok 3</div>
                    <div class="link-desc">Video khác</div>
                </div>
            </a>
        </div>

        <!-- Footer -->
        <div class="footer">
            ⚡ Désiré's Universe • Android Customization • KLWP/KLCK ⚡
        </div>
    </div>
</body>
</html>